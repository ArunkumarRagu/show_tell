APP_ENV=development
APP_NAME="HAT Show & Tell API"
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hat_app

# Security & Authentication
SECRET_KEY=super-secret-production-key-change-in-env-file
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
